package {
    default_visibility: [":__subpackages__"],
    default_applicable_licenses: ["external_kotlin.metadata_license"],
}

license {
    name: "external_kotlin.metadata_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

java_import_host {
    name: "kotlin_metadata_jvm",
    jars: ["kotlin-metadata-jvm-2.0.21.jar"],
    visibility: [
        "//external/auto/value",
        "//external/dagger2",
        "//external/kotlinx.atomicfu",
        "//prebuilts/sdk/current/androidx:__subpackages__",
    ],
}
